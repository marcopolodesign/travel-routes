{
  "functions": {
    "api/payment-request.tsx": {
      "includeFiles": "api/**"
    },
    "api/factura.tsx": {
      "includeFiles": "api/**"
    },
    "api/invoices.ts": {
      "includeFiles": "api/**"
    }
  },
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/api/$1"
    },
    {
      "source": "/deck/tecnofit",
      "destination": "/deck/tecnofit/index.html"
    },
    {
      "source": "/deck/tecnofit/",
      "destination": "/deck/tecnofit/index.html"
    },
    {
      "source": "/((?!.*\\.[^/]*$).*)",
      "destination": "/index.html"
    }
  ]
}
