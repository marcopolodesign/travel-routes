{
  "functions": {
    "api/payment-request.tsx": {
      "includeFiles": "api/**"
    },
    "api/factura.tsx": {
      "includeFiles": "api/**"
    },
    "api/invoices.ts": {
      "includeFiles": "api/**"
    }
  },
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/api/$1"
    },
    {
      "source": "/deck/tecnofit",
      "destination": "/deck/tecnofit/index.html"
    },
    {
      "source": "/deck/tecnofit/",
      "destination": "/deck/tecnofit/index.html"
    },
    {
      "source": "/deck/tecnofit-capitalizacion-v1",
      "destination": "/deck/tecnofit-capitalizacion-v1/index.html"
    },
    {
      "source": "/deck/tecnofit-capitalizacion-v1/",
      "destination": "/deck/tecnofit-capitalizacion-v1/index.html"
    },
    {
      "source": "/deck/tecnofit-capitalizacion-v2",
      "destination": "/deck/tecnofit-capitalizacion-v2/index.html"
    },
    {
      "source": "/deck/tecnofit-capitalizacion-v2/",
      "destination": "/deck/tecnofit-capitalizacion-v2/index.html"
    },
    {
      "source": "/reunion/tecnofit-sala-en-vivo",
      "destination": "/reunion/tecnofit-sala-en-vivo/index.html"
    },
    {
      "source": "/reunion/tecnofit-sala-en-vivo/",
      "destination": "/reunion/tecnofit-sala-en-vivo/index.html"
    },
    {
      "source": "/reunion/tecnofit-tvs-nuevas",
      "destination": "/reunion/tecnofit-tvs-nuevas/index.html"
    },
    {
      "source": "/reunion/tecnofit-tvs-nuevas/",
      "destination": "/reunion/tecnofit-tvs-nuevas/index.html"
    },
    {
      "source": "/((?!.*\\.[^/]*$).*)",
      "destination": "/index.html"
    }
  ]
}
